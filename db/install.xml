<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/randomdraw/db" VERSION="20240602"
       COMMENT="XMLDB file for mod_randomdraw activity module">
  <TABLES>

    <TABLE NAME="randomdraw" COMMENT="Each instance of the randomdraw activity">
      <FIELDS>
        <FIELD NAME="id"            TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="true"/>
        <FIELD NAME="course"        TYPE="int"  LENGTH="10" NOTNULL="true"  DEFAULT="0"/>
        <FIELD NAME="name"          TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="intro"         TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat"   TYPE="int"  LENGTH="4"  NOTNULL="true"  DEFAULT="0"/>
        <FIELD NAME="range_min"     TYPE="int"  LENGTH="10" NOTNULL="true"  DEFAULT="1"/>
        <FIELD NAME="range_max"     TYPE="int"  LENGTH="10" NOTNULL="true"  DEFAULT="20"/>
        <FIELD NAME="min_draws"     TYPE="int"  LENGTH="10" NOTNULL="true"  DEFAULT="1"
               COMMENT="Minimum draws required to complete the activity"/>
        <FIELD NAME="max_draws"     TYPE="int"  LENGTH="10" NOTNULL="true"  DEFAULT="0"
               COMMENT="Maximum draws allowed per student (0 = unlimited)"/>
        <FIELD NAME="timecreated"   TYPE="int"  LENGTH="10" NOTNULL="true"  DEFAULT="0"/>
        <FIELD NAME="timemodified"  TYPE="int"  LENGTH="10" NOTNULL="true"  DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="randomdraw_draws" COMMENT="Every number drawn by every user">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="randomdrawid" TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="number"       TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timedrawn"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary"         TYPE="primary"  FIELDS="id"/>
        <KEY NAME="fk_randomdrawid" TYPE="foreign"  FIELDS="randomdrawid"
             REFTABLE="randomdraw" REFFIELDS="id"/>
        <KEY NAME="fk_userid"       TYPE="foreign"  FIELDS="userid"
             REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="user_instance" UNIQUE="false" FIELDS="userid,randomdrawid"/>
      </INDEXES>
    </TABLE>

  </TABLES>
</XMLDB>
