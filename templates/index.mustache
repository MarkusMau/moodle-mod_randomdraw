{{!
    @template mod_randomdraw/index

    List of the random draw activities of a course.

    Example context (json):
    {
        "rows": [{"name": "Draw 1", "url": "https://example.com/mod/randomdraw/view.php?id=1", "range": "1 – 10", "totaldraws": 4}]
    }
}}
<table class="generaltable">
    <thead>
        <tr>
            <th>{{#str}}activityname, mod_randomdraw{{/str}}</th>
            <th>{{#str}}range, mod_randomdraw{{/str}}</th>
            <th>{{#str}}totaldraws, mod_randomdraw{{/str}}</th>
        </tr>
    </thead>
    <tbody>
        {{#rows}}
            <tr>
                <td><a href="{{url}}">{{{name}}}</a></td>
                <td>{{range}}</td>
                <td>{{totaldraws}}</td>
            </tr>
        {{/rows}}
    </tbody>
</table>
