{{!
    @template mod_randomdraw/view

    View page of a random draw activity, for managers and for students.

    Example context (json):
    {
        "hasflash": true,
        "flash": "You drew 7",
        "ismanager": true,
        "infoitems": [{"label": "Range", "value": "1 – 10", "valclass": ""}],
        "resetbutton": "<button type=\"button\">Reset all</button>",
        "hasdistribution": true,
        "distributiontitle": "Distribution",
        "bars": [{"number": 1, "count": 2, "countlabel": "2", "title": "1: 2x", "percent": 100, "barclass": "rd-bar-next"}],
        "nexttiertext": "1 numbers next",
        "isperfect": true,
        "perfecttext": "Perfect distribution",
        "allstudentstitle": "All students",
        "nodrawstext": "No draws yet",
        "hasstudents": true,
        "students": [{"name": "Anna", "done": true, "statustext": "Done", "draws": [{"number": 3}], "percent": 100}]
    }
}}
{{#hasflash}}
    <div class="rd-flash">{{flash}}</div>
{{/hasflash}}
<div class="rd-wrap">
{{#ismanager}}
    <div class="rd-info-bar">
        {{#infoitems}}
            <div class="rd-info-item">
                <span class="rd-info-label">{{label}}</span>
                <span class="rd-info-val {{valclass}}">{{value}}</span>
            </div>
        {{/infoitems}}
    </div>
    <div class="rd-actions">{{{resetbutton}}}</div>
    {{#hasdistribution}}
        <h3 class="rd-section-title">{{distributiontitle}}</h3>
        <div class="rd-distribution">
            {{#bars}}
                <div class="rd-bar-col" title="{{title}}">
                    <div class="rd-bar-count">{{countlabel}}</div>
                    <div class="rd-bar-track">
                        <div class="rd-bar-fill {{barclass}}" style="height: {{percent}}%"></div>
                    </div>
                    <div class="rd-bar-label">{{number}}</div>
                </div>
            {{/bars}}
        </div>
        <p class="rd-chart-legend">
            <span class="rd-legend-dot rd-bar-next"></span> {{nexttiertext}}
            {{#isperfect}} &nbsp;·&nbsp; <span class="rd-perfect">{{perfecttext}}</span>{{/isperfect}}
        </p>
    {{/hasdistribution}}
    <h3 class="rd-section-title mt-4">{{allstudentstitle}}</h3>
    {{^hasstudents}}
        <div class="rd-empty">{{nodrawstext}}</div>
    {{/hasstudents}}
    {{#hasstudents}}
        <div class="rd-students-grid">
            {{#students}}
                <div class="rd-student-card">
                    <div class="rd-student-header">
                        <span class="rd-student-name">{{{name}}}</span>
                        <span class="rd-status {{#done}}rd-status-done{{/done}}{{^done}}rd-status-progress{{/done}}">{{statustext}}</span>
                    </div>
                    <div class="rd-student-numbers">
                        {{#draws}}<span class="rd-num-chip">{{number}}</span>{{/draws}}
                    </div>
                    <div class="rd-mini-bar-bg"><div class="rd-mini-bar-fill {{#done}}done{{/done}}" style="width: {{percent}}%"></div></div>
                </div>
            {{/students}}
        </div>
    {{/hasstudents}}
{{/ismanager}}
{{^ismanager}}
    <div class="rd-student-view">
        {{#done}}
            <div class="rd-round-chip rd-chip-done">✓ {{donetext}}</div>
        {{/done}}
        {{^done}}
            <div class="rd-round-chip">{{neededtext}}</div>
        {{/done}}
        <div class="rd-predraw">
            {{#candraw}}
                <p class="rd-invite">{{invitetext}}</p>
                <form method="post" action="{{drawurl}}">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="rd-draw-btn">{{drawlabel}}</button>
                </form>
                {{#hascounter}}<p class="rd-counter">{{countertext}}</p>{{/hascounter}}
            {{/candraw}}
            {{^candraw}}
                <div class="rd-draw-btn rd-draw-btn-disabled">{{maxreachedtext}}</div>
            {{/candraw}}
        </div>
        {{#hasdraws}}
            <div class="rd-my-draws">
                <h3 class="rd-my-draws-title">{{mynumberstitle}}</h3>
                <div class="rd-pool-bar-bg mb-2">
                    <div class="rd-pool-bar-fill {{#done}}done{{/done}}" style="width: {{percent}}%"></div>
                </div>
                <p class="rd-pool-label mb-3">{{progresstext}}</p>
                <div class="rd-my-numbers">
                    {{#draws}}
                        <div class="rd-my-num-card">
                            <div class="rd-my-num-index">#{{index}}</div>
                            <div class="rd-my-num-val">{{number}}</div>
                            <div class="rd-my-num-time">{{time}}</div>
                        </div>
                    {{/draws}}
                </div>
            </div>
        {{/hasdraws}}
    </div>
{{/ismanager}}
</div>
